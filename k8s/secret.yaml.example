# Copy to secret.yaml (in this folder) and fill in real values.
# Never commit secret.yaml — it's in .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: solydshop-secrets
type: Opaque
stringData:
  DB_USERNAME: solydshop
  DB_PASSWORD: changeme
  JWT_SECRET: replace-with-a-long-random-string
  CLOUDINARY_API_KEY: your-api-key
  CLOUDINARY_API_SECRET: your-api-secret
  STRIPE_SECRET_KEY: sk_test_replace-me
  STRIPE_WEBHOOK_SECRET: whsec_replace-me
  MAIL_USERNAME: your-email@gmail.com
  MAIL_PASSWORD: your-app-password
  INTERNAL_API_KEY: replace-with-a-long-random-string
