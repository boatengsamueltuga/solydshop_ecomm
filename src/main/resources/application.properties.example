spring.application.name=ecommerce

# PostgreSQL Database
spring.datasource.url=jdbc:postgresql://localhost:5432/solydShopdb
spring.datasource.driverClassName=org.postgresql.Driver
spring.datasource.username=postgres
spring.datasource.password=changeme

# JPA
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

jwt.secret=replace-with-a-long-random-string
jwt.expiration=3600000

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Cloudinary (image hosting) - https://cloudinary.com
cloudinary.cloud-name=your-cloud-name
cloudinary.api-key=your-api-key
cloudinary.api-secret=your-api-secret

# Stripe (payments) - https://dashboard.stripe.com/test/apikeys
stripe.secret-key=sk_test_replace-me
stripe.publishable-key=pk_test_replace-me
# Run: stripe listen --forward-to localhost:8080/api/payment/webhook to get this value locally
stripe.webhook-secret=whsec_replace-me

# Mail (SMTP) - use a Gmail App Password, not your account password
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Frontend URL for password reset link
app.frontend-url=http://localhost:3000

# CORS - comma-separated list of allowed origins
cors.allowed-origins=http://localhost:3000

# Auth cookies - both must flip together for cross-site production use
cookie.secure=false
cookie.same-site=Lax

# Copy this file to application.properties and fill in real values.
# application.properties is git-ignored and must never be committed.
